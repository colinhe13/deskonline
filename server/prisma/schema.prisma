generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique @db.VarChar(32)
  password       String   @db.VarChar(255)
  points         Int      @default(10000)
  sessionVersion Int      @default(0) @map("session_version")
  isAi           Boolean  @default(false) @map("is_ai")
  personaId      String?  @map("persona_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  persona        AiPersona?       @relation(fields: [personaId], references: [id])
  buyInHolds         BuyInHold[]
  pointsTransactions PointsTransaction[]

  @@map("users")
}

model AiPersona {
  id            String   @id @default(uuid())
  slug          String   @unique @db.VarChar(32)
  displayName   String   @map("display_name") @db.VarChar(32)
  styleLabel    String   @map("style_label") @db.VarChar(32)
  promptSection String   @map("prompt_section")
  temperature   Float    @default(0.7)
  bluffHintRate Float    @default(0) @map("bluff_hint_rate")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("ai_personas")
}

model BuyInHold {
  id          String   @id @default(uuid())
  operationId String   @unique @map("operation_id") @db.VarChar(64)
  roomId      String   @map("room_id") @db.VarChar(32)
  userId      String   @map("user_id")
  seatIndex   Int      @map("seat_index")
  amount      Int
  status      String   @default("pending") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([roomId, status])
  @@index([userId, status])
  @@map("buy_in_holds")
}

model PointsTransaction {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  delta        Int
  balanceAfter Int      @map("balance_after")
  type         String   @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("points_transactions")
}
