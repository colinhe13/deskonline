generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique @db.VarChar(32)
  password       String   @db.VarChar(255)
  points         Int      @default(10000)
  sessionVersion Int      @default(0) @map("session_version")
  isAi           Boolean  @default(false) @map("is_ai")
  personaId      String?  @map("persona_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  persona        AiPersona?       @relation(fields: [personaId], references: [id])
  buyInHolds         BuyInHold[]
  pointsTransactions PointsTransaction[]
  aiSelfStats        AiSelfStats?
  aiHandSummaries    AiHandSummary[]

  @@map("users")
}

model AiPersona {
  id                   String    @id @default(uuid())
  slug                 String    @unique @db.VarChar(32)
  displayName          String    @map("display_name") @db.VarChar(32)
  styleLabel           String    @map("style_label") @db.VarChar(32)
  promptSection        String    @map("prompt_section")
  temperature          Float     @default(0.7)
  bluffHintRate        Float     @default(0) @map("bluff_hint_rate")
  evolvedBluffHintRate Float?    @map("evolved_bluff_hint_rate")
  evolvedTemperature   Float?    @map("evolved_temperature")
  evolvedAt            DateTime? @map("evolved_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  users User[]

  @@map("ai_personas")
}

// Cumulative self-outcome counters per AI account (own bluff/c-bet results),
// the evolution signal. Deliberately contains no opponent impressions and no
// hole cards.
model AiSelfStats {
  userId        String   @id @map("user_id")
  bluffAttempts Int      @default(0) @map("bluff_attempts")
  bluffSuccess  Int      @default(0) @map("bluff_success")
  cbetAttempts  Int      @default(0) @map("cbet_attempts")
  cbetSuccess   Int      @default(0) @map("cbet_success")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_self_stats")
}

// Distilled experience notes from the global reflection cycle. Scope is
// two-tier: personaSlug NULL = global lesson injected into every persona;
// otherwise persona-specific. Keyed by slug string (no FK) so lessons
// survive persona row churn and are trivially resettable per scope.
model AiLesson {
  id          String    @id @default(cuid())
  personaSlug String?   @map("persona_slug") @db.VarChar(32)
  text        String
  evidence    String
  status      String    @default("active") @db.VarChar(16)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  retiredAt   DateTime? @map("retired_at")

  @@index([personaSlug, status])
  @@map("ai_lessons")
}

// Compact per-hand self-view summaries — the raw material for reflection.
// Server-side only; never holds hole cards (own or opponents') and is
// window-pruned to the most recent rows per user at flush time.
model AiHandSummary {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  position      String   @db.VarChar(8)
  boardTexture  String   @map("board_texture") @db.VarChar(24)
  streetReached String   @map("street_reached") @db.VarChar(12)
  myBets        Int      @default(0) @map("my_bets")
  myRaises      Int      @default(0) @map("my_raises")
  facedBets     Int      @default(0) @map("faced_bets")
  bluffed       String?  @db.VarChar(8)
  cbet          String?  @db.VarChar(8)
  netWon        Int      @default(0) @map("net_won")
  wonAtShowdown Boolean  @default(false) @map("won_at_showdown")
  foldedToBet   Boolean  @default(false) @map("folded_to_bet")
  playedAt      DateTime @default(now()) @map("played_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
  @@index([playedAt])
  @@map("ai_hand_summaries")
}

model BuyInHold {
  id          String   @id @default(uuid())
  operationId String   @unique @map("operation_id") @db.VarChar(64)
  roomId      String   @map("room_id") @db.VarChar(32)
  userId      String   @map("user_id")
  seatIndex   Int      @map("seat_index")
  amount      Int
  status      String   @default("pending") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([roomId, status])
  @@index([userId, status])
  @@map("buy_in_holds")
}

model PointsTransaction {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  delta        Int
  balanceAfter Int      @map("balance_after")
  type         String   @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("points_transactions")
}
